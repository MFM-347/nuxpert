    "@nuxtjs/fontaine": "0.5.0",
    "@nuxtjs/seo": "3.4.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "14.2.1",
    "eslint": "^10.0.0",
    "eslint-plugin-oxlint": "^1.46.0",
    "js-convert-case": "^4.2.0",
    "nuxt": "^4.3.1",
    "nuxt-schema-org": "^5.0.10",
    "oxlint": "^1.47.0",
