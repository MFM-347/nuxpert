{
  "name": "nuxpert",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "oxlint && eslint",
    "lint:fix": "oxlint --fix && eslint --fix",
    "format": "prettier --write --experimental-cli app/",
    "predev": "nr lint && nr format && cls"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/fontaine": "0.5.0",
    "@nuxtjs/seo": "3.4.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "14.2.1",
    "js-convert-case": "^4.2.0",
    "nuxt": "^4.3.1",
    "nuxt-schema-org": "^5.0.10",
    "tailwindcss": "latest",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@antfu/ni": "^28.3.0",
    "@iconify-json/hugeicons": "^1.2.23",
    "@tailwindcss/vite": "latest",
    "eslint": "^10.0.3",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-oxlint": "^1.53.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "oxlint": "^1.53.0",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "beta"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
